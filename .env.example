# HA Bot environment (copy to .env for local runs; never commit real values).

# Telegram bot token from @BotFather (required).
BOT_TOKEN=your-telegram-bot-token

# Optional: enables encrypted on-disk persistence so credentials, the selected
# patient, and active monitoring tasks survive a worker restart. When unset, the
# bot keeps everything in memory only (state is lost on restart).
#
# Must be a url-safe base64 32-byte Fernet key. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HA_CRED_KEY=

# Optional: path to the encrypted state file (default: ha_state.enc in the working
# directory). On a deploy host, point this at a location that persists across
# restarts and is outside the git checkout's tracked files.
HA_STATE_PATH=ha_state.enc
